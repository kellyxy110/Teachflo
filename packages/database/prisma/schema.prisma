// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// SCHOOL (TENANT)
// ─────────────────────────────────────────────

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  state     String
  lga       String?
  address   String?
  logoUrl   String?
  plan      Plan     @default(FREE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teachers Teacher[]
  classes  Class[]
  students Student[]
  lessons  Lesson[]
  exams    Exam[]
  library   LibraryItem[]
  scores    Score[]
  documents Document[]
  questions Question[]

  @@map("schools")
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────
// TEACHER
// ─────────────────────────────────────────────

model Teacher {
  id           String      @id @default(cuid())
  clerkId      String      @unique
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id])
  firstName    String
  lastName     String
  email        String
  phone        String?
  role         TeacherRole @default(TEACHER)
  subjects     String[]
  classLevels  String[]
  isActive     Boolean     @default(true)
  photoUrl     String?
  bio          String?
  qualification String?
  institution  String?
  gradYear     Int?
  trcnNumber   String?
  trcnStatus   String?
  department   String?
  yearsOfExp   Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lessons    Lesson[]
  exams      Exam[]
  assessmentPublications AssessmentPublication[]
  releasedAttempts ExamAttempt[] @relation("ReleasedAttemptResults")
  scores     Score[]
  homework   Homework[]
  attendance Attendance[]
  authIdentities AuthIdentity[]
  questions Question[]
  curriculumProvenanceVerifications CurriculumProvenance[] @relation("CurriculumProvenanceVerifier")
  curriculumAlignmentReviews QuestionVersionCurriculumAlignment[] @relation("CurriculumAlignmentReviewer")
  curriculumSourceRegistrations CurriculumSource[] @relation("CurriculumSourceRegistrar")
  curriculumStagedReviews CurriculumStagedItem[] @relation("CurriculumStagedReviewer")
  gradedResponses QuestionResponse[] @relation("GradedResponses")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("teachers")
}

enum TeacherRole {
  TEACHER
  FORM_TEACHER
  HOD
  VICE_PRINCIPAL
  PRINCIPAL
  ADMIN
  SUPER_ADMIN
}

// ─────────────────────────────────────────────
// CLASS
// ─────────────────────────────────────────────

model Class {
  id        String     @id @default(cuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id])
  name      String
  level     ClassLevel
  arm       String?
  term      Term       @default(FIRST)
  session   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  students   Student[]
  scores     Score[]
  lessons    Lesson[]
  exams      Exam[]
  homework   Homework[]
  attendance Attendance[]

  @@unique([schoolId, name, session])
  @@index([schoolId])
  @@map("classes")
}

enum ClassLevel {
  JS1
  JS2
  JS3
  SS1
  SS2
  SS3
}

enum Term {
  FIRST
  SECOND
  THIRD
}

// ─────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────

model Student {
  id        String   @id @default(cuid())
  clerkId   String?  @unique
  email     String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  firstName String
  lastName  String
  // Original, un-split value when a student was imported from a single "Full
  // Name" column — preserved for audit/redo since firstName/lastName are
  // required elsewhere in the app and a full non-destructive split isn't
  // structurally supported yet (see docs/TASKS.md, Import Identity pass).
  rawFullName String?
  regNumber String?
  gender    Gender?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores          Score[]
  examAttempts    ExamAttempt[]
  mistakePatterns MistakePattern[]
  learningPaths   LearningPath[]
  attendance      Attendance[]
  healthRecord    HealthRecord?
  profile         StudentProfile?
  authIdentities  AuthIdentity[]

  @@unique([schoolId, regNumber])
  @@index([classId])
  @@index([clerkId])
  @@map("students")
}

enum Gender {
  MALE
  FEMALE
}

enum AuthProvider {
  CLERK
  SUPABASE
}

model AuthIdentity {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  teacherId      String?
  studentId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([teacherId])
  @@unique([studentId])
  @@index([providerUserId])
  @@map("auth_identities")
}

// ─────────────────────────────────────────────
// SCORE
// ─────────────────────────────────────────────

model Score {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   String
  term      Term
  session   String

  ca1    Float?
  ca2    Float?
  exam   Float?
  total  Float?
  grade  String?
  remark String?

  // School-specific imported assessment detail. `total` remains the supplied
  // source total; component values are never used to silently overwrite it.
  componentValues ScoreAssessmentComponentValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subject, term, session])
  @@index([schoolId])
  @@index([studentId])
  @@index([classId])
  @@index([teacherId])
  @@map("scores")
}

model AssessmentComponent {
  id             String   @id @default(cuid())
  schoolId       String
  name           String
  normalizedName String
  maxScore       Float?
  order          Int      @default(0)
  category       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  values ScoreAssessmentComponentValue[]

  @@unique([schoolId, normalizedName])
  @@index([schoolId, order])
  @@map("assessment_components")
}

model ScoreAssessmentComponentValue {
  id                    String              @id @default(cuid())
  scoreId               String
  assessmentComponentId String
  obtainedScore         Float?
  sourceLabel           String?
  sourceMaxScore        Float?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  score               Score               @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  assessmentComponent AssessmentComponent @relation(fields: [assessmentComponentId], references: [id], onDelete: Restrict)

  @@unique([scoreId, assessmentComponentId])
  @@index([assessmentComponentId])
  @@map("score_assessment_component_values")
}

// ─────────────────────────────────────────────
// LESSON
// ─────────────────────────────────────────────

model Lesson {
  id        String     @id @default(cuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   Teacher    @relation(fields: [teacherId], references: [id])
  classId   String?
  class     Class?     @relation(fields: [classId], references: [id])

  subject      String
  topic        String
  classLevel   ClassLevel
  week         Int?
  term         Term?

  objectives   String[]
  introduction String
  content      Json
  activities   Json[]
  evaluation   String[]
  homework     String[]

  mode         LessonMode @default(STANDARD)
  aiModel      String?
  promptTokens Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@map("lessons")
}

enum LessonMode {
  STANDARD
  ELI12
  WAEC
  JAMB
  JUPEB
}

// ─────────────────────────────────────────────
// EXAM
// ─────────────────────────────────────────────

model Exam {
  id        String     @id @default(cuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   Teacher    @relation(fields: [teacherId], references: [id])
  classId   String?
  class     Class?     @relation(fields: [classId], references: [id])

  title      String
  subject    String
  topic      String
  classLevel ClassLevel
  examType   ExamType
  difficulty Difficulty
  duration   Int?
  lifecycle  AssessmentLifecycle @default(DRAFT)
  instructions String?
  opensAt DateTime?
  closesAt DateTime?
  timezone String?
  resultReleasePolicy ResultReleasePolicy @default(AFTER_TEACHER_RELEASE)
  answerReleasePolicy AnswerReleasePolicy @default(NEVER)
  gradingMode AssessmentGradingMode @default(MIXED)
  passMarkPercent Float?
  draftRevision Int @default(1)
  publishedAt DateTime?
  archivedAt DateTime?

  examMode       ExamMode @default(STANDARD)
  blueprint      Json?
  totalQuestions  Int?
  targetStudentId String?

  questions Question[]
  assessmentItems AssessmentItem[]
  attempts  ExamAttempt[]
  publications AssessmentPublication[]

  aiModel      String?
  promptTokens Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@index([schoolId, lifecycle])
  @@index([opensAt, closesAt])
  @@map("exams")
}

enum ExamType {
  SCHOOL_TEST
  SCHOOL_EXAM
  WAEC_MOCK
  JAMB_PREP
  JUPEB_PREP
}

enum Difficulty {
  BASIC
  APPLICATION
  WAEC
  JAMB
  JUPEB
}

enum ExamMode {
  STANDARD
  DIAGNOSTIC
  PRACTICE
  ASSESSMENT
  ADAPTIVE
}

enum AssessmentLifecycle {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResultReleasePolicy {
  AFTER_SUBMISSION
  AFTER_CLOSE
  AFTER_TEACHER_RELEASE
}

enum AnswerReleasePolicy {
  NEVER
  AFTER_TEACHER_RELEASE
}

enum AssessmentGradingMode {
  AUTO
  MANUAL
  MIXED
}

// ─────────────────────────────────────────────
// QUESTION
// ─────────────────────────────────────────────

model Question {
  id     String @id @default(cuid())
  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)
  schoolId String?
  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdByTeacherId String?
  createdByTeacher Teacher? @relation(fields: [createdByTeacherId], references: [id], onDelete: Restrict)
  lifecycle QuestionLifecycle @default(DRAFT)
  sourceKind QuestionSourceKind @default(TEACHER)
  visibility QuestionVisibility @default(PRIVATE)
  defaultMarks Float?

  section      Section
  number       Int
  type         QuestionType

  stem          String
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  optionE       String?
  correctOption String?

  questionText String?
  markScheme   String?

  solution       String
  explanation    String
  distractors    Json?
  commonMistakes String?
  examTip        String?
  curriculumRef  String?

  difficulty      String?  @default("medium")
  bloomLevel      String?
  skillTag        String?
  topicTag        String?
  subTopicTag     String?
  questionSource  String?  @default("synthetic")
  estimatedTime   Int?     @default(90)
  relatedChunkIds String[]

  createdAt DateTime @default(now())

  responses QuestionResponse[]
  tags      QuestionTag[]
  versions QuestionVersion[]
  assessmentItems AssessmentItem[]
  publicationItems AssessmentPublicationItem[]

  @@index([examId])
  @@map("questions")
}

enum Section {
  A
  B
  C
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
  ESSAY
  STRUCTURED
  CALCULATION
}

// ─────────────────────────────────────────────
// HOMEWORK
// ─────────────────────────────────────────────

model Homework {
  id          String         @id @default(cuid())
  schoolId    String
  teacherId   String
  teacher     Teacher        @relation(fields: [teacherId], references: [id])
  classId     String
  class       Class          @relation(fields: [classId], references: [id])

  subject     String
  title       String
  description String
  dueDate     DateTime?
  status      HomeworkStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@map("homework")
}

enum HomeworkStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

// ─────────────────────────────────────────────
// LIBRARY
// ─────────────────────────────────────────────

model LibraryItem {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  title        String
  subject      String
  classLevel   ClassLevel?
  topic        String?
  category     LibraryCategory
  examType     ExamType?

  fileUrl  String
  fileSize Int?
  pageCount Int?

  isPublic      Boolean @default(false)
  isAIGenerated Boolean @default(false)

  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("library_items")
}

enum LibraryCategory {
  TEXTBOOK
  REVISION_GUIDE
  PAST_QUESTIONS
  FORMULA_SHEET
  TEACHER_NOTES
  AI_NOTES
}

enum QuestionLifecycle {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}
enum QuestionSourceKind {
  TEACHER
  AI
  IMPORTED
  PAST_QUESTION
  SYSTEM
}
enum QuestionVisibility {
  PRIVATE
  SCHOOL
  SYSTEM
}

model QuestionVersion {
  id String @id @default(cuid())
  questionId String
  version Int
  payload Json
  createdAt DateTime @default(now())
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  assessmentItems AssessmentItem[]
  publicationItems AssessmentPublicationItem[]
  curriculumAlignments QuestionVersionCurriculumAlignment[]
  @@unique([questionId, version])
  @@index([questionId])
  @@map("question_versions")
}

model AssessmentItem {
  id String @id @default(cuid())
  examId String
  questionId String
  questionVersionId String
  order Int
  section Section
  marksOverride Float?
  snapshot Json?
  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  publicationItems AssessmentPublicationItem[]
  @@unique([examId, order])
  @@index([examId])
  @@index([questionId])
  @@index([questionVersionId])
  @@map("assessment_items")
}

model AssessmentPublication {
  id String @id @default(cuid())
  examId String
  version Int
  publishedByTeacherId String
  title String
  subject String
  topic String
  classLevel ClassLevel
  instructions String?
  duration Int?
  opensAt DateTime?
  closesAt DateTime?
  timezone String?
  resultReleasePolicy ResultReleasePolicy
  answerReleasePolicy AnswerReleasePolicy
  gradingMode AssessmentGradingMode
  passMarkPercent Float?
  settingsSnapshot Json?
  contentHash String
  publishedAt DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict)
  publishedBy Teacher @relation(fields: [publishedByTeacherId], references: [id], onDelete: Restrict)
  items AssessmentPublicationItem[]
  attempts ExamAttempt[]

  @@unique([examId, version])
  @@index([examId])
  @@index([publishedAt])
  @@map("assessment_publications")
}

model AssessmentPublicationItem {
  id String @id @default(cuid())
  publicationId String
  assessmentItemId String?
  questionId String
  questionVersionId String
  order Int
  section Section
  marks Float
  snapshot Json

  publication AssessmentPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  assessmentItem AssessmentItem? @relation(fields: [assessmentItemId], references: [id], onDelete: Restrict)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  responses QuestionResponse[]

  @@unique([publicationId, order])
  @@unique([publicationId, questionId])
  @@index([questionVersionId])
  @@map("assessment_publication_items")
}

// ─────────────────────────────────────────────
// EXAM ATTEMPT (student takes an exam)
// ─────────────────────────────────────────────

model ExamAttempt {
  id        String        @id @default(cuid())
  studentId String
  student   Student       @relation(fields: [studentId], references: [id])
  examId    String
  exam      Exam          @relation(fields: [examId], references: [id])
  schoolId  String

  status     AttemptStatus @default(IN_PROGRESS)
  totalScore Float?
  maxScore   Float?
  percentage Float?
  grade      String?

  examMode           ExamMode @default(STANDARD)
  analytics          Json?
  currentDifficulty  String?  @default("medium")
  questionsAnswered  Int      @default(0)
  adaptiveState      Json?
  publicationId String?
  deadlineAt DateTime?
  deliverySnapshot Json?

  startedAt   DateTime @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?
  resultReleasedAt DateTime?
  resultReleasedByTeacherId String?

  responses QuestionResponse[]
  publication AssessmentPublication? @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  resultReleasedBy Teacher? @relation("ReleasedAttemptResults", fields: [resultReleasedByTeacherId], references: [id], onDelete: Restrict)

  @@unique([studentId, examId])
  @@index([schoolId])
  @@index([publicationId])
  @@map("exam_attempts")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

// ─────────────────────────────────────────────
// QUESTION RESPONSE (student's answer per question)
// ─────────────────────────────────────────────

model QuestionResponse {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id])
  publicationItemId String?
  publicationItem AssessmentPublicationItem? @relation(fields: [publicationItemId], references: [id], onDelete: Restrict)

  selectedOption   String?
  textResponse     String?
  isCorrect        Boolean?
  score            Float?
  maxScore         Float    @default(1)
  timeSpentSeconds Int?

  misconception    String?
  feedback         String?
  errorType        String?
  difficultyAtTime String?
  gradedByTeacherId String?
  gradedAt DateTime?
  gradedBy Teacher? @relation("GradedResponses", fields: [gradedByTeacherId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([publicationItemId])
  @@map("question_responses")
}

// ─────────────────────────────────────────────
// QUESTION TAG (skill / topic metadata)
// ─────────────────────────────────────────────

model QuestionTag {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  skill       String
  topic       String?
  subtopic    String?
  bloomsLevel BloomsLevel?

  @@unique([questionId, skill])
  @@index([skill])
  @@map("question_tags")
}

enum BloomsLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

// ─────────────────────────────────────────────
// DOCUMENT (uploaded PDFs for RAG)
// ─────────────────────────────────────────────

model Document {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id])
  teacherId String

  title     String
  subject   String
  classLevel ClassLevel?
  fileName  String
  mimeType  String         @default("application/pdf")
  fileSize  Int            @default(0)
  pageCount Int?

  status    DocumentStatus @default(PENDING)
  visibility DocumentVisibility @default(SCHOOL)
  chunkCount Int           @default(0)
  error     String?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([schoolId])
  @@map("documents")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DocumentVisibility {
  PRIVATE
  SCHOOL
}

// ─────────────────────────────────────────────
// MISTAKE INTELLIGENCE (Phase 2B)
// ─────────────────────────────────────────────

model MistakePattern {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId        String
  skill           String
  errorType       String
  pattern         String
  rootCause       String?
  prerequisiteGap String?
  occurrences     Int      @default(1)
  lastSeen        DateTime @default(now())
  firstSeen       DateTime @default(now())
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([studentId, skill, errorType])
  @@index([studentId])
  @@index([schoolId])
  @@index([skill])
  @@map("mistake_patterns")
}

// ─────────────────────────────────────────────
// ADAPTIVE LEARNING PATHS (Phase 2A)
// ─────────────────────────────────────────────

model LearningPath {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId       String
  subject        String
  classLevel     String
  steps          Json     @default("[]")
  currentStep    Int      @default(0)
  status         String   @default("ACTIVE")
  lastComputedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, subject])
  @@index([studentId])
  @@index([schoolId])
  @@map("learning_paths")
}

// ─────────────────────────────────────────────
// CURRICULUM PLANS (Phase 3A)
// ─────────────────────────────────────────────

model CurriculumPlan {
  id                 String   @id @default(cuid())
  schoolId           String
  teacherId          String
  subject            String
  classLevel         String
  term               String
  session            String
  title              String
  weeks              Json     @default("[]")
  assessmentSchedule Json?
  revisionCycles     Json?
  performanceContext Json?
  aiModel            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([schoolId, subject, classLevel, term, session])
  @@index([schoolId])
  @@index([teacherId])
  @@map("curriculum_plans")
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model Attendance {
  id        String           @id @default(cuid())
  schoolId  String
  classId   String
  studentId String
  teacherId String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([classId, date])
  @@index([studentId])
  @@index([teacherId])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ─────────────────────────────────────────────
// STUDENT HEALTH RECORD
// ─────────────────────────────────────────────

model HealthRecord {
  id          String   @id @default(cuid())
  studentId   String   @unique
  schoolId    String

  bloodGroup  String?
  genotype    String?
  allergies   String[]
  conditions  String[]
  medications String[]

  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String?

  parentPhone    String?
  parentEmail    String?

  immunizations  Json?
  clinicVisits   Json?
  healthNotes    String?

  lastUpdatedBy String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("health_records")
}

// ─────────────────────────────────────────────
// CURRICULUM INTELLIGENCE GRAPH (CIG) — CUR-001
// ─────────────────────────────────────────────

enum NodeType {
  SUBJECT
  TOPIC
  CONCEPT
  SKILL
  LEARNING_OBJECTIVE
  EXAM_STANDARD
}

enum EdgeRelation {
  REQUIRES
  EXTENDS
  PART_OF
  RELATED_TO
  ASSESSED_BY
  VISUALIZED_BY
  PRACTICED_BY
  APPEARS_IN
  TEACHES_BEFORE
  TEACHES_AFTER
  CROSS_SUBJECT
}

enum CurriculumDifficulty {
  EASY
  MEDIUM
  HARD
}

enum CurriculumLifecycle {
  DRAFT
  REVIEWED
  PUBLISHED
  ARCHIVED
}

enum AlignmentStatus {
  UNMAPPED
  PROPOSED
  REVIEWED
  APPROVED
  REJECTED
}

enum CurriculumSourceKind {
  HUMAN_CREATED
  IMPORTED
  CURRICULUM_SEEDED
}

enum CurriculumSourceType {
  OFFICIAL_DOCUMENT
  INSTITUTIONAL
  STRUCTURED_DATASET
  TEACHER_PROVIDED
  UNKNOWN
}

enum SourceAuthorityLevel {
  OFFICIAL
  INSTITUTIONAL
  VERIFIED_SECONDARY
  TEACHER_PROVIDED
  UNKNOWN
}

enum SourceVerificationState {
  UNVERIFIED
  REVIEWED
  VERIFIED
  REJECTED
}

enum IngestionJobState {
  REGISTERED
  VALIDATING
  EXTRACTING
  NORMALIZING
  STAGED
  NEEDS_REVIEW
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum StagedReviewState {
  NEEDS_REVIEW
  EDITED
  APPROVED
  REJECTED
  PUBLISHED
}

model Curriculum {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  authority String
  kind      String
  scope     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CurriculumVersion[]
  sources CurriculumSource[]

  @@map("curricula")
}

model CurriculumSource {
  id                  String                 @id @default(cuid())
  fingerprint         String                 @unique
  title               String
  sourceType          CurriculumSourceType   @default(UNKNOWN)
  authorityLevel      SourceAuthorityLevel   @default(UNKNOWN)
  verificationState   SourceVerificationState @default(UNVERIFIED)
  organization        String?
  sourceUrl           String?
  fileName            String?
  mimeType            String?
  byteSize            Int?
  publicationYear     Int?
  effectiveYear       Int?
  jurisdiction        String?
  country             String?
  licenseNote         String?
  curriculumId        String?
  curriculumVersionId String?
  registeredAt        DateTime               @default(now())
  registeredByTeacherId String?
  curriculum          Curriculum?            @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  curriculumVersion   CurriculumVersion?     @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  registeredBy         Teacher?               @relation("CurriculumSourceRegistrar", fields: [registeredByTeacherId], references: [id], onDelete: Restrict)
  jobs                 CurriculumIngestionJob[]

  @@index([curriculumId])
  @@index([curriculumVersionId])
  @@index([verificationState])
  @@map("curriculum_sources")
}

model CurriculumVersion {
  id           String             @id @default(cuid())
  curriculumId String
  versionKey   String
  title        String
  editionYear  Int?
  status       CurriculumLifecycle @default(DRAFT)
  publishedAt  DateTime?
  archivedAt   DateTime?
  sourceDocument String?
  curriculum   Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  nodes        CurriculumNode[]
  provenance   CurriculumProvenance[]
  alignments   QuestionVersionCurriculumAlignment[]
  sources      CurriculumSource[]
  ingestionJobs CurriculumIngestionJob[]

  @@unique([curriculumId, versionKey])
  @@index([status])
  @@map("curriculum_versions")
}

model CurriculumIngestionJob {
  id                String            @id @default(cuid())
  sourceId          String
  curriculumVersionId String?
  state             IngestionJobState  @default(REGISTERED)
  revision          Int               @default(1)
  rawHash           String?
  errorMessage      String?
  registeredAt      DateTime          @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime          @updatedAt
  source            CurriculumSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  curriculumVersion CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  stagedItems       CurriculumStagedItem[]

  @@unique([sourceId, revision])
  @@index([state])
  @@index([curriculumVersionId, state])
  @@map("curriculum_ingestion_jobs")
}

model CurriculumStagedItem {
  id                    String            @id @default(cuid())
  jobId                 String
  stableKey             String
  parentStableKey       String?
  type                  NodeType
  label                 String
  normalizedText        String?
  rawText               String
  description           String?
  subject               String?
  classLevel            ClassLevel?
  term                  Term?
  sourcePage            String?
  sourceSection         String?
  extractionConfidence  Float?
  classificationConfidence Float?
  reviewState           StagedReviewState @default(NEEDS_REVIEW)
  reviewRevision        Int               @default(1)
  reviewNotes           String?
  reviewedByTeacherId   String?
  reviewedAt            DateTime?
  publishedNodeId       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  job                   CurriculumIngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewedBy            Teacher?          @relation("CurriculumStagedReviewer", fields: [reviewedByTeacherId], references: [id], onDelete: Restrict)
  publishedNode         CurriculumNode?   @relation("StagedPublishedNode", fields: [publishedNodeId], references: [id], onDelete: Restrict)

  @@unique([jobId, stableKey])
  @@index([jobId, reviewState])
  @@index([publishedNodeId])
  @@map("curriculum_staged_items")
}

model CurriculumProvenance {
  id                 String   @id @default(cuid())
  curriculumVersionId String
  organization       String?
  documentTitle      String
  editionYear        Int?
  sourceUrl          String?
  pageOrSection      String?
  extractionMethod   String?
  confidence         Float?
  importedAt         DateTime @default(now())
  verifiedAt         DateTime?
  verifiedByTeacherId String?
  notes              String?
  version            CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  verifiedBy         Teacher? @relation("CurriculumProvenanceVerifier", fields: [verifiedByTeacherId], references: [id], onDelete: Restrict)

  @@index([curriculumVersionId])
  @@index([verifiedByTeacherId])
  @@map("curriculum_provenance")
}

model QuestionVersionCurriculumAlignment {
  id                 String             @id @default(cuid())
  questionVersionId  String
  curriculumNodeId   String
  curriculumVersionId String
  status             AlignmentStatus    @default(UNMAPPED)
  sourceKind         CurriculumSourceKind @default(HUMAN_CREATED)
  confidence         Float?
  notes              String?
  reviewedAt         DateTime?
  reviewedByTeacherId String?
  questionVersion    QuestionVersion   @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  node               CurriculumNode    @relation(fields: [curriculumNodeId], references: [id], onDelete: Restrict)
  version            CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  reviewedBy         Teacher?          @relation("CurriculumAlignmentReviewer", fields: [reviewedByTeacherId], references: [id], onDelete: Restrict)

  @@unique([questionVersionId, curriculumNodeId, curriculumVersionId])
  @@index([curriculumNodeId, status])
  @@index([curriculumVersionId, status])
  @@index([reviewedByTeacherId])
  @@map("question_version_curriculum_alignments")
}

model CurriculumNode {
  id               String                @id @default(cuid())
  curriculumVersionId String?
  stableKey        String?
  schoolId         String?
  type             NodeType
  label            String
  description      String?
  subject          String?
  classLevel       ClassLevel?
  term             Term?
  week             Int?
  difficulty       CurriculumDifficulty?
  estimatedMinutes Int?
  bloomLevels      String[]
  examStandards    String[]
  keywords         String[]
  misconceptions   String[]
  formulae         Json?
  metadata         Json?
  version          Int                   @default(1)
  createdBy        String?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  outgoing CurriculumEdge[] @relation("EdgeSource")
  incoming CurriculumEdge[] @relation("EdgeTarget")
  curriculumVersion CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  questionAlignments QuestionVersionCurriculumAlignment[]
  stagedPublishedItems CurriculumStagedItem[] @relation("StagedPublishedNode")

  @@index([type])
  @@index([subject, classLevel, term])
  @@index([schoolId])
  @@index([curriculumVersionId, type])
  @@unique([curriculumVersionId, stableKey])
  @@map("curriculum_nodes")
}

model CurriculumEdge {
  id           String       @id @default(cuid())
  sourceId     String
  targetId     String
  relationship EdgeRelation
  weight       Float?       @default(1.0)
  metadata     Json?
  createdAt    DateTime     @default(now())

  source CurriculumNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target CurriculumNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationship])
  @@index([sourceId])
  @@index([targetId])
  @@index([relationship])
  @@map("curriculum_edges")
}

// ─────────────────────────────────────────────
// VECTOR TABLES (pgvector — managed via raw SQL)
// ─────────────────────────────────────────────

model LessonEmbedding {
  id        String                       @id @default(cuid())
  lessonId  String                       @unique
  schoolId  String
  content   String
  metadata  Json?
  embedding Unsupported("vector(1024)")
  createdAt DateTime                     @default(now())

  @@index([schoolId])
  @@map("lesson_embeddings")
}

model QuestionEmbedding {
  id         String                       @id @default(cuid())
  questionId String                       @unique
  schoolId   String
  content    String
  metadata   Json?
  embedding  Unsupported("vector(1024)")
  createdAt  DateTime                     @default(now())

  @@index([schoolId])
  @@map("question_embeddings")
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  schoolId   String
  content    String
  metadata   Json?
  embedding  Unsupported("vector(1024)")
  chunkIndex Int                          @default(0)
  createdAt  DateTime                     @default(now())

  @@index([schoolId])
  @@index([documentId])
  @@map("document_chunks")
}

// ─────────────────────────────────────────────
// STUDENT DATA HUB — Import, Sync, Analytics
// ─────────────────────────────────────────────

enum ImportSource {
  EXCEL
  CSV
  PORTAL
  MANUAL
  OCR
}

enum ImportStatus {
  PENDING
  ANALYZING
  COMMITTING
  STAGED
  CONFIRMED
  COMMITTED
  FAILED
  DISCARDED
}

enum StagingAction {
  CREATE
  UPDATE
  SKIP
  CONFLICT
}

enum StagingStatus {
  PENDING
  RESOLVED
  COMMITTED
  SKIPPED
}

enum ConflictResolution {
  KEEP_EXISTING
  REPLACE
  MERGE
  SKIP
}

enum SyncType {
  INITIAL
  INCREMENTAL
  FULL
  MANUAL
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model ImportJob {
  id              String       @id @default(cuid())
  schoolId        String
  teacherId       String
  source          ImportSource
  fileName        String?
  status          ImportStatus @default(PENDING)
  totalRows       Int          @default(0)
  newStudents     Int          @default(0)
  updatedStudents Int          @default(0)
  newScores       Int          @default(0)
  conflicts       Int          @default(0)
  errors          String[]
  metadata        Json?
  committedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  stagingRows ImportStagingRow[]

  @@index([schoolId])
  @@index([teacherId])
  @@map("import_jobs")
}

model ImportStagingRow {
  id           String              @id @default(cuid())
  jobId        String
  job          ImportJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowIndex     Int
  rawData      Json
  parsedData   Json
  action       StagingAction       @default(CREATE)
  status       StagingStatus       @default(PENDING)
  conflictData Json?
  resolution   ConflictResolution?
  error        String?
  studentId    String?

  @@index([jobId])
  @@map("import_staging_rows")
}

model SyncLog {
  id          String     @id @default(cuid())
  schoolId    String
  teacherId   String
  type        SyncType
  source      String
  status      SyncStatus
  summary     Json
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  @@index([schoolId])
  @@map("sync_logs")
}

model PortalConnection {
  id           String    @id @default(cuid())
  schoolId     String
  teacherId    String
  portalType   String
  displayName  String
  schoolName   String?
  sessionToken String?
  tokenExpiry  DateTime?
  isActive     Boolean   @default(true)
  lastSynced   DateTime?
  syncSettings Json?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([schoolId, portalType])
  @@index([schoolId])
  @@map("portal_connections")
}

model IntegrationRequest {
  id           String    @id @default(cuid())
  schoolId     String
  teacherId    String
  connectorId  String
  schoolName   String
  portalUrl    String
  adminContact String
  message      String?
  status       String    @default("NEW")
  createdAt    DateTime  @default(now())

  @@index([schoolId])
  @@index([status])
  @@map("integration_requests")
}

// Subject Registry — school-confirmed raw → canonical subject name mappings,
// learned from import confirmations (e.g. "maths" -> "Mathematics"). Deliberately
// scoped to a required schoolId rather than a nullable "global" row: Postgres
// treats NULL as distinct from NULL in unique constraints, so a nullable-schoolId
// design would silently permit duplicate "global" aliases. Platform-wide default
// synonyms live in code (lib/services/import/subject-normalize.ts) instead.
model SubjectAlias {
  id               String   @id @default(cuid())
  schoolId         String
  rawValue         String   // normalized (trimmed, lowercased) source text
  canonicalSubject String   // teacher-confirmed canonical name for this school
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([schoolId, rawValue])
  @@index([schoolId])
  @@map("subject_aliases")
}

model StudentProfile {
  id             String    @id @default(cuid())
  studentId      String    @unique
  schoolId       String
  dateOfBirth    DateTime?
  photoUrl       String?
  parentName     String?
  parentPhone    String?
  parentEmail    String?
  parentRelation String?
  address        String?
  state          String?
  lga            String?
  formerSchool   String?
  admissionDate  DateTime?
  nationality    String?
  religion       String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("student_profiles")
}

model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  schoolId   String
  classId    String?
  studentId  String?
  subject    String?
  term       Term?
  session    String
  type       String
  data       Json
  computedAt DateTime @default(now())

  @@index([schoolId])
  @@index([classId])
  @@index([studentId])
  @@map("analytics_snapshots")
}
